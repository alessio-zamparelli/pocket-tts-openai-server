# Version control
.git
.gitignore

# Local Python environment (platform-specific — must never ship into the image)
.venv
venv
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
coverage.xml
htmlcov/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Test / docs artifacts
tests/
*.log

# Local-only voice-clone experiment data: the patient corpus (480 licensed
# recordings) and scratch outputs (cloned voices, generated samples, proofs).
# These must never enter the image. The pre-cloned voice that the image DOES
# ship lives in the repo `voices/` dir instead.
audio files/
artifacts/
